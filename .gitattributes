# Normaliza los finales de línea y evita diffs binarios innecesarios.
* text=auto eol=lf

*.py   text eol=lf
*.html text eol=lf
*.css  text eol=lf
*.js   text eol=lf
*.json text eol=lf
*.yml  text eol=lf
*.yaml text eol=lf
*.md   text eol=lf
*.txt  text eol=lf
*.ps1  text eol=crlf

*.png   binary
*.jpg   binary
*.jpeg  binary
*.gif   binary
*.webp  binary
*.ico   binary
*.ttf   binary
*.woff  binary
*.woff2 binary
*.pdf   binary
*.docx  binary
*.xlsx  binary
*.sqlite3 binary
